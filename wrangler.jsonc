{
  "name": "lumino-test-web",
  "compatibility_date": "2025-01-01",
  "main": "web-worker.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*"
    ]
  },
  "vars": {
    "ADMIN_ENABLED": "false",
    "ADMIN_URL": "https://layover-admin.progen-web.workers.dev/admin"
  }
}
